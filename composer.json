{
    "name": "leafs/mvc-core",
    "description": "Core files specific to MVC based leaf frameworks like Leaf MVC and Leaf API.",
    "keywords": [
        "microframework",
        "rest",
        "mvc",
        "leaf",
        "php",
        "framework"
    ],
    "homepage": "https://leafphp.dev/docs/mvc/",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Darko",
            "email": "mickdd22@gmail.com",
            "homepage": "https://mychi.netlify.app",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Leaf\\": "src"
        },
        "files": [
            "src/globals/bootstrap.php",
            "src/globals/config.php",
            "src/globals/paths.php",
            "src/globals/functions.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "leafs/leaf": "^5.0",
        "vlucas/phpdotenv": "*",
        "illuminate/support": "*",
        "illuminate/database": "*",
        "illuminate/events": "*",
        "symfony/yaml": "*",
        "leafs/db": "^5.1",
        "leafs/sprout": "^5.1"
    },
    "require-dev": {
        "pestphp/pest": "*",
        "leafs/alchemy": "^5.0",
        "fakerphp/faker": "*",
        "friendsofphp/php-cs-fixer": "*"
    },
    "scripts": {
        "alchemy": "@php vendor/bin/alchemy all",
        "test": "@php vendor/bin/alchemy test",
        "lint": "@php vendor/bin/alchemy lint",
        "fmt": "@php vendor/bin/alchemy fmt",
        "refactor": "@php vendor/bin/alchemy refactor",
        "analyse": "@php vendor/bin/alchemy analyse",
        "ci": "@php vendor/bin/alchemy ci"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}